{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/omid3098/dio-voice/release-manifest.schema.json",
  "title": "DIO Voice portable release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "entrypoint", "components"],
  "properties": {
    "schema": { "const": 1 },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$",
      "maxLength": 63
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 259
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "sha256",
          "bytes",
          "installed_bytes",
          "target",
          "profile",
          "archive"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "maxLength": 63
          },
          "url": {
            "type": "string",
            "pattern": "^https://",
            "maxLength": 2047
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "bytes": { "type": "integer", "minimum": 1 },
          "installed_bytes": { "type": "integer", "minimum": 1 },
          "target": { "type": "string", "minLength": 1, "maxLength": 259 },
          "profile": { "enum": ["all", "small", "large"] },
          "archive": { "enum": ["cab", "file"] }
        }
      }
    }
  }
}
