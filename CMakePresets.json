{
  "version": 6,
  "configurePresets": [
    {
      "name": "x64-release",
      "displayName": "MSVC x64 Release",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/vs-x64-release",
      "cacheVariables": {
        "DIO_CUI_PREFIX": "$env{DIO_CUI_PREFIX}",
        "DIO_RUNTIME_DIR": "${sourceDir}/runtime"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-release",
      "configurePreset": "x64-release",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "x64-release",
      "configurePreset": "x64-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
